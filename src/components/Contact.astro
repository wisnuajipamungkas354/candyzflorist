---
const waNumber = "6289688035866";
const waDisplay = "+62 896-8803-5866";
const emailAddress = "Candyzflorist.id@gmail.com";
const instagramHandle = "@candyzflorist_";
const instagramUrl = "https://instagram.com/candyzflorist_";
const tiktokHandle = "@candyzflorist_";
const tiktokUrl = "https://www.tiktok.com/@candyzflorist_?is_from_webapp=1&sender_device=pc";
const linkedinUrl = "https://www.linkedin.com/company/candyzflorist/";
const addressText = "Blok F No.528, Perumnas bumi, Telukjambe Timur, Karawang, Jawa Barat 41361";
const mapsSearchUrl = "https://maps.app.goo.gl/Dc9zeMDpkT5RfMJ27";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent("Halo Candyzflorist (Kak Niken), saya ingin konsultasi & order bunga untuk momen spesial.")}`;

// Generate QR Code URL via reliable QR API for direct WhatsApp chat
const waQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(`https://wa.me/${waNumber}?text=Halo%20Candyzflorist%20(Kak%20Niken),%20saya%20ingin%20tanya%20order%20bunga`)}`;
---

<section id="contact" class="py-24 bg-floral-cream/70 relative overflow-hidden">
  <!-- Subtle decorative ambient blobs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-floral-pink-200/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-floral-gold-200/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4 border border-floral-pink-200">
        Get In Touch
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-4">
        Hubungi & Kunjungi Kami
      </h2>
      <p class="text-base sm:text-lg text-floral-muted">
        Siap melayani pesanan online via WhatsApp, konsultasi kustom bunga, pendaftaran kelas, maupun kunjungan studio.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Business Card Details & Contacts -->
      <div class="lg:col-span-6 space-y-5">
        
        <!-- Florist Owner Identity Card (Inspired by Business Card) -->
        <div class="p-6 sm:p-7 rounded-3xl bg-white border border-floral-pink-200 shadow-soft relative overflow-hidden group">
          <!-- Background decorative logo watermarked -->
          <div class="absolute -right-6 -bottom-6 w-36 h-36 opacity-5 pointer-events-none">
            <img src="/logo.jpg" alt="Logo background" class="w-full h-full object-cover rounded-full" />
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-floral-pink-100">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-floral-pink-500 to-floral-pink-400 p-0.5 shadow-soft shrink-0">
                <div class="w-full h-full bg-white rounded-[14px] flex items-center justify-center text-floral-pink-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-serif text-2xl font-bold text-floral-dark tracking-tight">Niken Hartanti</h3>
                <p class="text-sm font-serif italic text-floral-pink-600 font-medium">Owner and Florist</p>
              </div>
            </div>
            
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="px-2.5 py-1 rounded-full bg-floral-pink-50 border border-floral-pink-200 text-floral-pink-700 text-[11px] font-semibold">Bouquet</span>
              <span class="px-2.5 py-1 rounded-full bg-floral-pink-50 border border-floral-pink-200 text-floral-pink-700 text-[11px] font-semibold">Gift</span>
              <span class="px-2.5 py-1 rounded-full bg-floral-gold-50 border border-floral-gold-200 text-floral-gold-700 text-[11px] font-semibold">Class</span>
              <span class="px-2.5 py-1 rounded-full bg-floral-pink-50 border border-floral-pink-200 text-floral-pink-700 text-[11px] font-semibold">Decor</span>
            </div>
          </div>

          <!-- Contact items in Business Card layout -->
          <div class="pt-5 space-y-3.5">
            <!-- Email -->
            <a
              href={`mailto:${emailAddress}`}
              class="flex items-center gap-3.5 text-floral-dark hover:text-floral-pink-600 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-floral-pink-50 text-floral-pink-600 flex items-center justify-center shrink-0 group-hover/item:bg-floral-pink-500 group-hover/item:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-floral-muted">Email Resmi</p>
                <p class="text-sm font-medium text-floral-dark group-hover/item:text-floral-pink-600 transition-colors truncate">{emailAddress}</p>
              </div>
            </a>

            <!-- Phone / WhatsApp -->
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 text-floral-dark hover:text-green-600 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-green-50 text-green-600 flex items-center justify-center shrink-0 group-hover/item:bg-green-500 group-hover/item:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-floral-muted">WhatsApp / Telepon</p>
                <p class="text-sm font-semibold text-floral-dark group-hover/item:text-green-600 transition-colors">{waDisplay}</p>
              </div>
              <span class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1 rounded-full border border-green-200">
                Chat Sekarang →
              </span>
            </a>

            <!-- Address -->
            <div class="flex items-start gap-3.5 text-floral-dark pt-1">
              <div class="w-9 h-9 rounded-xl bg-floral-gold-50 text-floral-gold-700 flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-floral-muted">Alamat Studio</p>
                <p class="text-sm font-medium text-floral-dark leading-relaxed">
                  {addressText}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Media & Professional Network Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <!-- Instagram -->
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 rounded-3xl bg-white border border-floral-pink-200 shadow-soft hover:shadow-soft-lg hover:border-floral-pink-300 transition-all duration-300 flex items-center gap-3.5 group"
          >
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-semibold text-floral-muted uppercase block">Instagram</span>
              <span class="text-xs sm:text-sm font-bold text-floral-dark group-hover:text-floral-pink-600 transition-colors block truncate">{instagramHandle}</span>
            </div>
          </a>

          <!-- TikTok -->
          <a
            href={tiktokUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 rounded-3xl bg-white border border-floral-pink-200 shadow-soft hover:shadow-soft-lg hover:border-floral-pink-300 transition-all duration-300 flex items-center gap-3.5 group"
          >
            <div class="w-10 h-10 rounded-2xl bg-black text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.65 6.34 6.34 0 0 0 9.35 22a6.33 6.33 0 0 0 6.34-6.33V9.2a7.9 7.9 0 0 0 3.9 1.08V6.85a5.53 5.53 0 0 1 0-.16z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-semibold text-floral-muted uppercase block">TikTok</span>
              <span class="text-xs sm:text-sm font-bold text-floral-dark group-hover:text-floral-pink-600 transition-colors block truncate">{tiktokHandle}</span>
            </div>
          </a>

          <!-- LinkedIn -->
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 rounded-3xl bg-white border border-floral-pink-200 shadow-soft hover:shadow-soft-lg hover:border-floral-pink-300 transition-all duration-300 flex items-center gap-3.5 group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#0077B5] text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-semibold text-floral-muted uppercase block">LinkedIn</span>
              <span class="text-xs sm:text-sm font-bold text-floral-dark group-hover:text-[#0077B5] transition-colors block truncate">Candyz Florist</span>
            </div>
          </a>
        </div>

        <!-- WhatsApp QR Code Scan Card -->
        <div class="p-6 rounded-3xl bg-gradient-to-r from-emerald-500/10 via-green-500/10 to-teal-500/10 border border-green-200 flex flex-col sm:flex-row items-center gap-5">
          <div class="w-24 h-24 sm:w-28 sm:h-28 bg-white p-2 rounded-2xl shadow-sm border border-green-200 shrink-0 flex items-center justify-center">
            <img
              src={waQrUrl}
              alt="Scan WhatsApp Candyz Florist"
              class="w-full h-full object-contain rounded-lg"
              loading="lazy"
            />
          </div>
          <div class="text-center sm:text-left flex-1">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 text-[10px] font-bold uppercase tracking-wider mb-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
              </svg>
              <span>Fast Scan</span>
            </div>
            <h4 class="font-serif text-base font-bold text-floral-dark mb-1">Scan QR Code WhatsApp</h4>
            <p class="text-xs text-floral-muted leading-relaxed mb-3">
              Scan barcode dengan kamera ponsel Anda untuk langsung membuka chat WhatsApp dengan Florist kami.
            </p>
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-green-700 hover:text-green-800 transition-colors"
            >
              <span>Atau Klik Di Sini untuk Chat Langsung</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Map Embed -->
      <div class="lg:col-span-6 flex flex-col gap-4">
        <div class="h-[430px] sm:h-[480px] rounded-3xl overflow-hidden shadow-soft-lg border border-floral-pink-200 bg-white relative group">
          <iframe
            src="https://maps.google.com/maps?q=-6.3364531,107.2857975&hl=id&z=17&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Lokasi Studio Toko Bunga Candyzflorist Karawang"
          ></iframe>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-4 rounded-2xl bg-white border border-floral-pink-100 shadow-soft">
          <div class="flex items-center gap-2 text-xs text-floral-muted">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-floral-pink-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Toko Bunga Candyzflorist Karawang</span>
          </div>
          <a
            href={mapsSearchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-floral-pink-600 hover:text-floral-pink-700 transition-colors"
          >
            <span>Buka di Google Maps</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

