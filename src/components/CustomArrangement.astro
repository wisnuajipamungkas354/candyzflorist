---
const waNumber = "6289688035866";
const waCustomText = encodeURIComponent("Halo Candyzflorist, saya ingin konsultasi rangkaian bunga kustom (request warna/tema/budget).");
const waCustomLink = `https://wa.me/${waNumber}?text=${waCustomText}`;
---

<section id="custom" class="py-20 bg-gradient-to-br from-floral-pink-50 via-floral-cream to-floral-gold-50 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-card rounded-3xl sm:rounded-5xl p-8 sm:p-12 lg:p-16 border border-floral-pink-200/80 shadow-soft-lg relative overflow-hidden">
      
      <!-- Background floral accents -->
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-floral-pink-200/40 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
        
        <!-- Left Content -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4">
            Custom Arrangement
          </div>
          
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-5 leading-tight">
            Dibuat Sesuai <span class="italic font-normal text-floral-pink-600">Keinginanmu</span>
          </h2>
          
          <p class="text-base sm:text-lg text-floral-muted leading-relaxed mb-6">
            Punya konsep, warna wrapping favorit, paduan bunga tertentu, atau budget yang ingin disesuaikan? Candyzflorist siap mewujudkan rangkaian bunga impian Anda untuk setiap momen spesial.
          </p>

          <!-- Custom benefits -->
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-sm text-floral-dark">
              <span class="w-5 h-5 rounded-full bg-floral-gold-400 text-white flex items-center justify-center text-xs font-bold">✓</span>
              <span>Bebas pilih kombinasi warna wrapping dan pita satin eksklusif</span>
            </li>
            <li class="flex items-center gap-3 text-sm text-floral-dark">
              <span class="w-5 h-5 rounded-full bg-floral-gold-400 text-white flex items-center justify-center text-xs font-bold">✓</span>
              <span>Bisa custom kartu ucapan personal bernuansa elegan</span>
            </li>
            <li class="flex items-center gap-3 text-sm text-floral-dark">
              <span class="w-5 h-5 rounded-full bg-floral-gold-400 text-white flex items-center justify-center text-xs font-bold">✓</span>
              <span>Konsultasi ramah dan cepat langsung dengan florist kami</span>
            </li>
          </ul>

          <a
            href={waCustomLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-floral-pink-500 to-floral-pink-600 hover:from-floral-pink-600 hover:to-floral-pink-700 text-white font-semibold text-base shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Konsultasi Desain via WhatsApp</span>
          </a>
        </div>

        <!-- Right Side Graphic / Mockup -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-sm aspect-square rounded-3xl overflow-hidden shadow-soft-lg border-2 border-white bg-floral-pink-100">
            <img
              src="https://images.unsplash.com/photo-1563241527-3004b7be0ffd?auto=format&fit=crop&w=700&q=80"
              alt="Custom Floral Arrangement Process"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-floral-dark/60 via-transparent to-transparent flex items-end p-6">
              <p class="text-white text-sm font-medium flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 fill-current text-floral-gold-300" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Setiap rangkaian memiliki keunikan dan cerita tersendiri.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
