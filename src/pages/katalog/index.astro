<Layout
  title="Katalog Produk | Candyzflorist Karawang"
  description="Temukan koleksi lengkap bouquet, gift, dekorasi bunga dari Candyzflorist Karawang."
>
  <Navbar />

  <main class="pt-24 pb-20">
    <section class="py-10 sm:py-12 bg-floral-cream/50 min-h-screen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================= -->

        <div class="max-w-2xl mb-8 sm:mb-10">
          <div
            class="inline-flex items-center px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4"
          >
            Katalog Lengkap
          </div>

          <h1
            class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-3"
          >
            Katalog Produk
          </h1>

          <p class="text-sm sm:text-base text-floral-muted leading-relaxed">
            Temukan koleksi rangkaian bunga dan gift dari Candyzflorist.
            Hubungi kami untuk informasi harga dan ketersediaan.
          </p>
        </div>


        <!-- ================================= -->
        <!-- MOBILE FILTER BUTTON -->
        <!-- ================================= -->

        <div class="lg:hidden mb-5">
          <button
            id="open-filter"
            type="button"
            class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border border-floral-pink-200 rounded-xl text-sm font-semibold text-floral-dark shadow-sm hover:border-floral-pink-400 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
              />
            </svg>

            <span>Filter Produk</span>

            <span
              id="mobile-filter-count"
              class="hidden min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-floral-pink-600 text-white text-[10px]"
            >
            </span>
          </button>
        </div>


        <!-- ================================= -->
        <!-- CONTENT -->
        <!-- ================================= -->

        <div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">


          <!-- ================================= -->
          <!-- SIDEBAR / FILTER -->
          <!-- ================================= -->

          <aside
            id="filter-sidebar"
            class="
              fixed inset-0 z-50 hidden
              lg:static lg:block
              lg:z-auto
            "
          >

            <!-- Mobile Overlay -->
            <div
              id="filter-overlay"
              class="absolute inset-0 bg-black/30 lg:hidden"
            ></div>


            <!-- Filter Panel -->
            <div
              class="
                absolute right-0 top-0 h-full w-[85%] max-w-sm
                bg-white overflow-y-auto
                lg:static lg:w-auto lg:max-w-none
                lg:h-auto lg:overflow-visible
                lg:bg-white lg:rounded-2xl
                lg:border lg:border-gray-100
                lg:shadow-sm
              "
            >

              <!-- Filter Header -->
              <div
                class="sticky top-0 z-10 bg-white border-b border-gray-100 px-5 py-4 lg:static"
              >
                <div class="flex items-center justify-between">

                  <div>
                    <h2 class="font-semibold text-floral-dark">
                      Filter
                    </h2>

                    <p class="text-xs text-floral-muted mt-0.5">
                      Pilih sesuai kebutuhan
                    </p>
                  </div>

                  <!-- Mobile Close -->
                  <button
                    id="close-filter"
                    type="button"
                    class="lg:hidden p-2 -mr-2 text-gray-400 hover:text-floral-dark"
                    aria-label="Tutup filter"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-5 h-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                  </button>

                </div>
              </div>


              <!-- Filter Body -->
              <div class="p-5">


                <!-- ======================== -->
                <!-- KOLEKSI -->
                <!-- ======================== -->

                <div class="mb-7">

                  <h3
                    class="text-sm font-semibold text-floral-dark mb-4"
                  >
                    Koleksi
                  </h3>

                  <div class="space-y-3">

                    {categories.map((category) => (
                      <label
                        class="flex items-start gap-3 cursor-pointer group"
                      >
                        <input
                          type="checkbox"
                          name="category"
                          value={category.id}
                          class="category-checkbox mt-0.5 w-4 h-4 shrink-0 accent-floral-pink-600 rounded"
                        />

                        <span
                          class="text-sm text-floral-muted leading-snug group-hover:text-floral-pink-600 transition-colors"
                        >
                          {category.label}
                        </span>
                      </label>
                    ))}

                  </div>

                </div>


                <!-- ======================== -->
                <!-- HARGA -->
                <!-- ======================== -->

                <div class="pt-6 border-t border-gray-100">

                  <h3
                    class="text-sm font-semibold text-floral-dark mb-4"
                  >
                    Rentang Harga
                  </h3>

                  <div class="space-y-3">

                    {priceRanges.map((range) => (
                      <label
                        class="flex items-start gap-3 cursor-pointer group"
                      >
                        <input
                          type="checkbox"
                          name="price"
                          value={range.id}
                          class="price-checkbox mt-0.5 w-4 h-4 shrink-0 accent-floral-pink-600 rounded"
                        />

                        <span
                          class="text-sm text-floral-muted leading-snug group-hover:text-floral-pink-600 transition-colors"
                        >
                          {range.label}
                        </span>
                      </label>
                    ))}

                  </div>

                </div>


                <!-- ======================== -->
                <!-- RESET -->
                <!-- ======================== -->

                <button
                  id="reset-filter"
                  type="button"
                  class="w-full mt-8 py-2.5 px-4 rounded-lg border border-floral-pink-200 text-floral-pink-600 hover:bg-floral-pink-50 text-sm font-semibold transition-colors"
                >
                  Reset Filter
                </button>

              </div>


              <!-- Mobile Apply -->
              <div
                class="sticky bottom-0 bg-white border-t border-gray-100 p-4 lg:hidden"
              >
                <button
                  id="apply-filter"
                  type="button"
                  class="w-full py-3 rounded-xl bg-floral-pink-600 hover:bg-floral-pink-700 text-white text-sm font-semibold transition-colors"
                >
                  Tampilkan Produk
                </button>
              </div>

            </div>

          </aside>


          <!-- ================================= -->
          <!-- PRODUCT AREA -->
          <!-- ================================= -->

          <div class="min-w-0">


            <!-- Result Info -->
            <div
              class="flex items-center justify-between mb-5"
            >
              <p class="text-sm text-floral-muted">
                <span
                  id="product-count"
                  class="font-semibold text-floral-dark"
                >
                  {products.length}
                </span>
                produk ditemukan
              </p>

              <button
                id="desktop-reset"
                type="button"
                class="hidden lg:block text-sm font-medium text-floral-pink-600 hover:text-floral-pink-700"
              >
                Reset filter
              </button>
            </div>


            <!-- ================================= -->
            <!-- PRODUCT GRID -->
            <!-- ================================= -->

            <div
              id="product-grid"
              class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5"
            >

              {products.map((product) => {

                const productWaText = encodeURIComponent(
                  `Halo Candyzflorist, saya tertarik pesan produk: *${product.name}*. Boleh info ketersediaan dan harganya?`
                );

                const productWaLink =
                  `https://wa.me/${waNumber}?text=${productWaText}`;

                return (
                  <div
                    class="product-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 flex flex-col group hover:-translate-y-1"
                    data-category={product.category}
                    data-price={product.price}
                  >

                    <!-- Image -->
                    <div class="aspect-square overflow-hidden bg-floral-pink-50">

                      <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />

                    </div>


                    <!-- Info -->
                    <div class="p-3 sm:p-4 flex flex-col gap-1">

                      <h3
                        class="font-sans text-xs sm:text-sm font-medium text-floral-dark leading-snug line-clamp-2 min-h-[2.5rem]"
                      >
                        {product.name}
                      </h3>

                      <p
                        class="text-floral-pink-600 font-semibold text-xs sm:text-sm"
                      >
                        {formatPrice(product.price)}
                      </p>


                      <!-- WA -->
                      <a
                        href={productWaLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-2 sm:px-3 rounded-md bg-floral-pink-100 hover:bg-floral-pink-500 text-floral-pink-700 hover:text-white font-semibold text-[10px] sm:text-xs transition-all duration-300 mt-1.5"
                      >

                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-3 h-3 shrink-0 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.669-.967-.941 1.165-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                        </svg>

                        <span>Pesan via WA</span>

                      </a>

                    </div>

                  </div>
                );
              })}

            </div>


            <!-- ================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================= -->

            <div
              id="empty-state"
              class="hidden text-center py-20 text-floral-muted"
            >

              <div class="flex justify-center mb-4 text-floral-pink-300">

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-12 h-12"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0H4"
                  />
                </svg>

              </div>

              <p class="font-medium text-floral-dark">
                Tidak ada produk yang sesuai.
              </p>

              <p class="text-sm mt-1">
                Coba ubah kategori atau rentang harga.
              </p>

            </div>

          </div>

        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>


<script>
  /*
   * ==========================================
   * ELEMENTS
   * ==========================================
   */

  const categoryCheckboxes =
    document.querySelectorAll<HTMLInputElement>(
      '.category-checkbox'
    );

  const priceCheckboxes =
    document.querySelectorAll<HTMLInputElement>(
      '.price-checkbox'
    );

  const productCards =
    document.querySelectorAll<HTMLElement>(
      '.product-card'
    );

  const productCount =
    document.getElementById('product-count');

  const emptyState =
    document.getElementById('empty-state');

  const resetFilter =
    document.getElementById('reset-filter');

  const desktopReset =
    document.getElementById('desktop-reset');

  const mobileFilterCount =
    document.getElementById('mobile-filter-count');

  const filterSidebar =
    document.getElementById('filter-sidebar');

  const filterOverlay =
    document.getElementById('filter-overlay');

  const openFilter =
    document.getElementById('open-filter');

  const closeFilter =
    document.getElementById('close-filter');

  const applyFilter =
    document.getElementById('apply-filter');


  /*
   * ==========================================
   * GET SELECTED FILTER
   * ==========================================
   */

  function getSelectedCategories(): string[] {
    return Array.from(categoryCheckboxes)
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value);
  }


  function getSelectedPrices(): string[] {
    return Array.from(priceCheckboxes)
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value);
  }


  /*
   * ==========================================
   * PRICE MATCH
   * ==========================================
   */

  function matchPrice(
    price: number,
    ranges: string[]
  ): boolean {

    // Tidak ada filter harga
    if (ranges.length === 0) {
      return true;
    }

    return ranges.some((range) => {

      switch (range) {

        case 'under-100':
          return price < 100000;

        case '100-200':
          return price >= 100000 &&
                 price <= 200000;

        case '200-500':
          return price > 200000 &&
                 price <= 500000;

        case 'over-500':
          return price > 500000;

        default:
          return false;
      }

    });
  }


  /*
   * ==========================================
   * FILTER PRODUCTS
   * ==========================================
   */

  function filterProducts() {

    const selectedCategories =
      getSelectedCategories();

    const selectedPrices =
      getSelectedPrices();

    let visibleCount = 0;


    productCards.forEach((card) => {

      const category =
        card.dataset.category ?? '';

      const price =
        Number(card.dataset.price ?? 0);


      /*
       * Category
       *
       * Jika tidak ada kategori dipilih,
       * berarti semua kategori.
       */

      const categoryMatch =
        selectedCategories.length === 0 ||
        selectedCategories.includes(category);


      /*
       * Price
       */

      const priceMatch =
        matchPrice(
          price,
          selectedPrices
        );


      /*
       * Final result
       */

      const isVisible =
        categoryMatch &&
        priceMatch;


      if (isVisible) {

        card.style.display = '';

        visibleCount++;

      } else {

        card.style.display = 'none';

      }

    });


    /*
     * Update count
     */

    if (productCount) {

      productCount.textContent =
        String(visibleCount);

    }


    /*
     * Empty state
     */

    if (emptyState) {

      emptyState.classList.toggle(
        'hidden',
        visibleCount > 0
      );

    }


    /*
     * Mobile filter badge
     */

    const totalFilters =
      selectedCategories.length +
      selectedPrices.length;

    if (mobileFilterCount) {

      if (totalFilters > 0) {

        mobileFilterCount.textContent =
          String(totalFilters);

        mobileFilterCount.classList.remove(
          'hidden'
        );

        mobileFilterCount.classList.add(
          'inline-flex'
        );

      } else {

        mobileFilterCount.classList.add(
          'hidden'
        );

        mobileFilterCount.classList.remove(
          'inline-flex'
        );

      }

    }

  }


  /*
   * ==========================================
   * CHECKBOX EVENTS
   * ==========================================
   */

  categoryCheckboxes.forEach((checkbox) => {

    checkbox.addEventListener(
      'change',
      filterProducts
    );

  });


  priceCheckboxes.forEach((checkbox) => {

    checkbox.addEventListener(
      'change',
      filterProducts
    );

  });


  /*
   * ==========================================
   * RESET
   * ==========================================
   */

  function resetFilters() {

    categoryCheckboxes.forEach(
      (checkbox) => {
        checkbox.checked = false;
      }
    );

    priceCheckboxes.forEach(
      (checkbox) => {
        checkbox.checked = false;
      }
    );

    filterProducts();

  }


  resetFilter?.addEventListener(
    'click',
    resetFilters
  );

  desktopReset?.addEventListener(
    'click',
    resetFilters
  );


  /*
   * ==========================================
   * MOBILE FILTER
   * ==========================================
   */

  function openFilterPanel() {

    filterSidebar?.classList.remove(
      'hidden'
    );

    document.body.classList.add(
      'overflow-hidden'
    );

  }


  function closeFilterPanel() {

    filterSidebar?.classList.add(
      'hidden'
    );

    document.body.classList.remove(
      'overflow-hidden'
    );

  }


  openFilter?.addEventListener(
    'click',
    openFilterPanel
  );

  closeFilter?.addEventListener(
    'click',
    closeFilterPanel
  );

  filterOverlay?.addEventListener(
    'click',
    closeFilterPanel
  );

  applyFilter?.addEventListener(
    'click',
    closeFilterPanel
  );


  /*
   * ==========================================
   * INITIAL FILTER
   * ==========================================
   */

  filterProducts();
</script>