---
const waNumber = "6289688035866";
const waHeroMessage = encodeURIComponent("Halo Candyzflorist, saya ingin konsultasi & pesan bunga untuk momen spesial.");
const waLink = `https://wa.me/${waNumber}?text=${waHeroMessage}`;
---

<section id="home" class="relative pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden bg-gradient-to-b from-floral-pink-50/70 via-floral-cream to-white">
  <!-- Subtle Floral Glows in Background -->
  <div class="absolute top-10 left-1/4 w-96 h-96 bg-floral-pink-200/40 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse-subtle"></div>
  <div class="absolute top-40 right-10 w-80 h-80 bg-floral-gold-200/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copywriting & CTA -->
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        
        <!-- Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100/80 border border-floral-pink-200 text-floral-pink-700 text-xs sm:text-sm font-semibold mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-floral-pink-500 animate-ping"></span>
          <span>Florist Karawang • Handcrafted with Care</span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-floral-dark leading-[1.15] tracking-tight mb-6">
          Bunga untuk <span class="italic font-normal text-floral-pink-500">Setiap Momen</span> Spesial
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-floral-muted max-w-xl mb-8 leading-relaxed">
          Hadirkan kesan istimewa melalui rangkaian bunga yang dibuat dengan penuh perhatian. Sempurnakan hari bahagia, kelulusan, anniversary, hingga kado kejutan tak terlupakan.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-floral-pink-500 to-floral-pink-600 hover:from-floral-pink-600 hover:to-floral-pink-700 text-white font-semibold text-base shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Pesan via WhatsApp</span>
          </a>
          
          <a
            href="#collection"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-white hover:bg-floral-pink-50 text-floral-dark font-semibold text-base border border-floral-pink-200 shadow-sm hover:border-floral-pink-300 transition-all duration-300"
          >
            <span>Lihat Koleksi</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-floral-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Trust Badges List -->
        <div class="mt-10 pt-8 border-t border-floral-pink-100 grid grid-cols-3 gap-6 w-full max-w-lg">
          <div>
            <div class="font-serif text-2xl font-bold text-floral-pink-600">Fresh</div>
            <div class="text-xs text-floral-muted mt-0.5">Bunga Segar Pilihan</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-bold text-floral-gold-600">Custom</div>
            <div class="text-xs text-floral-muted mt-0.5">Desain Sesuai Request</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-bold text-floral-pink-600">Karawang</div>
            <div class="text-xs text-floral-muted mt-0.5">Pengiriman Cepat</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Floral Showcase / Card Composition -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        
        <!-- Main Floral Card -->
        <div class="relative w-full max-w-md bg-white rounded-3xl p-4 shadow-soft-lg border border-floral-pink-100 overflow-hidden group">
          <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-floral-pink-100 relative">
            <img
              src="https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=800&q=80"
              alt="Candyzflorist Signature Bouquet"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
            
            <!-- Floating tag on bottom of image -->
            <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md rounded-xl p-3 border border-white/40 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-floral-dark">Signature Rose & Lily Bouquet</p>
                <p class="text-[11px] text-floral-muted">Made with passion</p>
              </div>
              <span class="px-2.5 py-1 bg-floral-pink-100 text-floral-pink-700 text-[10px] font-bold rounded-full">
                BEST SELLER
              </span>
            </div>
          </div>
        </div>

        <!-- Floating Badge: Google Review / Rating -->
        <div class="absolute -top-4 -left-4 sm:top-6 sm:-left-8 bg-white/95 backdrop-blur-md rounded-2xl p-3.5 shadow-soft border border-floral-pink-100 flex items-center gap-3 animate-float">
          <div class="w-10 h-10 rounded-full bg-floral-gold-100 flex items-center justify-center text-floral-gold-500 font-bold">
            ★
          </div>
          <div>
            <div class="flex items-center gap-1">
              <span class="text-xs font-bold text-floral-dark">5.0 Star Rating</span>
            </div>
            <p class="text-[11px] text-floral-muted">Pelanggan Puas Karawang</p>
          </div>
        </div>

        <!-- Floating Badge: Fast Delivery / Custom -->
        <div class="absolute -bottom-5 -right-4 sm:bottom-4 sm:-right-6 bg-white/95 backdrop-blur-md rounded-2xl p-3.5 shadow-soft border border-floral-pink-100 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-floral-pink-100 flex items-center justify-center text-floral-pink-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-floral-dark">Same Day Available</p>
            <p class="text-[11px] text-floral-muted">Area Karawang & Sekitar</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
