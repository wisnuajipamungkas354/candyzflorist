    tag: 'Favorite'
  },
  {
    id: 'artificial-flower',
    name: 'Artificial Flower Bouquet',
    category: 'Everlasting',
    description: 'Rangkaian bunga artificial premium berkualitas tinggi yang awet, elegan, dan bisa disimpan selamanya sebagai kenangan.',
    image: 'https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&w=700&q=80',
    tag: 'Durable'
  },
  {
    id: 'flower-arrangement',
    name: 'Table Flower Arrangement',
    category: 'Arrangement',
    description: 'Rangkaian bunga meja artistik dalam vas cantik untuk memperindah sudut ruangan rumah, kantor, atau venue acara.',
    image: 'https://images.unsplash.com/photo-1582794543139-8ac9cb0f7b11?auto=format&fit=crop&w=700&q=80',
    tag: 'Premium'
  },
  {
    id: 'gift-bouquet',
    name: 'Special Gift Bouquet',
    category: 'Gift & Celebration',
    description: 'Bouquet kado istimewa untuk momen wisuda, sidang skripsi, anniversary, atau ungkapan terima kasih penuh cinta.',
    image: 'https://images.unsplash.com/photo-1563241527-3004b7be0ffd?auto=format&fit=crop&w=700&q=80',
    tag: 'Best Seller'
  },
  {
    id: 'hantaran-decoration',
    name: 'Hantaran & Seserahan Decor',
    category: 'Wedding & Engagement',
    description: 'Hiasan bunga estetis untuk kotak seserahan, lamaran, dan mahar pernikahan dengan sentuhan eksklusif.',
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=700&q=80',
    tag: 'Custom'
  },
  {
    id: 'bloom-box',
    name: 'Luxury Bloom Box',
    category: 'Exclusive Gift',
    description: 'Rangkaian bunga indah tersusun rapi di dalam kotak silinder premium berlabel eksklusif untuk kejutan romantis.',
    image: 'https://images.unsplash.com/photo-1534790566855-4cb788d389ec?auto=format&fit=crop&w=700&q=80',
    tag: 'New'
  },
  {
    id: 'standing-flower',
    name: 'Grand Standing Flower',
    category: 'Congratulation',
    description: 'Rangkaian bunga berdiri elegan untuk ucapan selamat grand opening, peresmian gedung, atau sukacita perusahaan.',
    image: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=700&q=80',
    tag: 'Formal'
  },
  {
    id: 'custom-bouquet',
    name: 'Creative Custom Bouquet',
