---

<section id="collection" class="py-24 bg-floral-warm/50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4">
        Our Collection
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-4">
        Pilihan Rangkaian Terbaik
      </h2>
      <p class="text-base sm:text-lg text-floral-muted">
        Jelajahi berbagai karya bunga terbaik kami. Setiap desain dirangkai dengan teliti dan dapat dikustomisasi sesuai preferensi warna atau tema Anda.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {products.map((product) => {
        const productWaText = encodeURIComponent(`Halo Candyzflorist, saya tertarik pesan produk: *${product.name}*. Boleh info ketersediaan dan detailnya?`);
        const productWaLink = `https://wa.me/${waNumber}?text=${productWaText}`;

        return (
          <div class="bg-white rounded-3xl overflow-hidden shadow-soft hover:shadow-soft-lg border border-floral-pink-100/70 transition-all duration-300 flex flex-col group hover:-translate-y-1.5">
            <!-- Image Area -->
            <div class="aspect-square relative overflow-hidden bg-floral-pink-50">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 right-3">
                <span class="px-3 py-1 bg-white/90 backdrop-blur-md rounded-full text-[11px] font-bold text-floral-pink-600 shadow-sm border border-floral-pink-100">
                  {product.tag}
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-semibold tracking-wider text-floral-gold-600 uppercase">
                  {product.category}
                </span>
                <h3 class="font-serif text-xl font-bold text-floral-dark group-hover:text-floral-pink-600 transition-colors mt-1 mb-2">
                  {product.name}
                </h3>
                <p class="text-xs sm:text-sm text-floral-muted leading-relaxed line-clamp-3 mb-6">
                  {product.description}
                </p>
              </div>

              <!-- Action button -->
              <a
                href={productWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-2xl bg-floral-pink-50 hover:bg-floral-pink-500 text-floral-pink-700 hover:text-white font-semibold text-sm transition-all duration-300 group-hover:shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Pesan via WA</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Mini Bottom Note -->
    <div class="mt-12 text-center">
      <p class="text-sm text-floral-muted">
        ✨ Butuh custom jumlah tangkai bunga, warna wrapping kertas, atau pita khusus? 
        <a href="#custom" class="text-floral-pink-600 font-semibold underline hover:text-floral-pink-700 ml-1">
          Konsultasikan dengan kami
        </a>
      </p>
    </div>

  </div>
</section>
