---
const waNumber = "6289688035866";

const products = [
  {
    name: 'COLORFUL',
    category: 'ready-stock',
    price: 175000,
    image: '/catalog/ready-stock/01-colorful.png',
  },
  {
    name: 'TROPHY FLOWERS',
    category: 'ready-stock',
    price: 225000,
    image: '/catalog/ready-stock/02-trophy-flowers.png',
  },
  {
    name: 'CIEL',
    category: 'ready-stock',
    price: 100000,
    image: '/catalog/ready-stock/03-ciel.png',
  },
  {
    name: 'MOCHI',
    category: 'ready-stock',
    price: 115000,
    image: '/catalog/ready-stock/04-mochi.png',
  },
  {
    name: 'Mila',
    category: 'ready-stock',
    price: 115000,
    image: '/catalog/ready-stock/05-mila.png',
  },
  {
    name: 'THUMBELINA BLOOMBOX',
    category: 'ready-stock',
    price: 265000,
    image: '/catalog/ready-stock/06-thumbelina-bloombox.png',
  },
  {
    name: 'Baby Blue',
    category: 'ready-stock',
    price: 145000,
    image: '/catalog/ready-stock/07-baby-blue.png',
  },
  {
    name: 'SOFT PEACH',
    category: 'ready-stock',
    price: 147000,
    image: '/catalog/ready-stock/08-soft-peach.png',
  },
];
---

<section id="collection" class="py-20 bg-floral-warm/50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4">
        Our Collection
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-4">
        Pilihan Rangkaian Terbaik
      </h2>
      <p class="text-base sm:text-lg text-floral-muted">
        Jelajahi berbagai karya bunga terbaik kami. Setiap desain dirangkai dengan teliti dan dapat dikustomisasi sesuai preferensi warna atau tema Anda.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {products.map((product) => {
        const productWaText = encodeURIComponent(`Halo Candyzflorist, saya tertarik pesan produk: *${product.name}*. Boleh info ketersediaan dan harganya?`);
        const productWaLink = `https://wa.me/${waNumber}?text=${productWaText}`;

        return (
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 flex flex-col group hover:-translate-y-1">
            <!-- Image Area -->
            <div class="aspect-square overflow-hidden bg-floral-pink-50">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Content Area -->
            <div class="p-3 sm:p-4 flex flex-col gap-1">
              <h3 class="font-sans text-xs sm:text-sm font-medium text-floral-dark leading-snug line-clamp-2 min-h-[2.5rem]">
                {product.name}
              </h3>
              <p class="text-floral-pink-600 font-semibold text-sm">{product.price}</p>

              <!-- WA Button -->
              <a
                href={productWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-md bg-floral-pink-100 hover:bg-floral-pink-500 text-floral-pink-700 hover:text-white font-semibold text-[11px] sm:text-xs transition-all duration-300 mt-1.5"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Pesan via WA</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- View All Catalog CTA -->
    <div class="mt-10 text-center flex flex-col items-center gap-5">
      <a href="/katalog" class="inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-full bg-floral-pink-600 hover:bg-floral-pink-700 text-white font-bold text-sm transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-1">
        <span>Lihat Semua Katalog Produk</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      
      <p class="text-sm text-floral-muted flex items-center gap-1.5 justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-floral-gold-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
        Butuh custom khusus? 
        <a href="#custom" class="text-floral-pink-600 font-semibold underline hover:text-floral-pink-700 ml-1">
          Konsultasikan dengan kami
        </a>
      </p>
    </div>

  </div>
</section>
