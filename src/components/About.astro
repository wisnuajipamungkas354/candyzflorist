---
---

<section id="about" class="py-20 bg-white relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 w-72 h-72 bg-floral-pink-50 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Visual Image Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <div class="rounded-3xl overflow-hidden shadow-soft border border-floral-pink-100 aspect-[4/5] bg-floral-pink-50">
            <img
              src="https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&w=600&q=80"
              alt="Florist Workshop"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-5 rounded-3xl bg-floral-pink-50 border border-floral-pink-100 text-center">
            <span class="font-serif text-3xl font-bold text-floral-pink-600 block">100+</span>
            <span class="text-xs text-floral-muted font-medium mt-1 block">Variasi Desain Rangkaian</span>
          </div>
        </div>

        <div class="space-y-4 pt-8">
          <div class="p-5 rounded-3xl bg-floral-gold-50 border border-floral-gold-200 text-center">
            <span class="font-serif text-3xl font-bold text-floral-gold-600 block">Local</span>
            <span class="text-xs text-floral-muted font-medium mt-1 block">Studio Telukjambe Karawang</span>
          </div>
          <div class="rounded-3xl overflow-hidden shadow-soft border border-floral-pink-100 aspect-[4/5] bg-floral-pink-50">
            <img
              src="https://images.unsplash.com/photo-1582794543139-8ac9cb0f7b11?auto=format&fit=crop&w=600&q=80"
              alt="Fresh Flower arrangement"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Text Story -->
      <div class="lg:col-span-7 flex flex-col justify-center lg:pl-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-floral-pink-100/70 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider w-fit mb-4">
          Tentang Kami
        </div>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-6 leading-tight">
          Sentuhan Keindahan untuk Cerita Bahagiamu
        </h2>

        <p class="text-base sm:text-lg text-floral-muted leading-relaxed mb-6">
          <strong class="text-floral-dark font-semibold">Candyz Florist</strong> didirikan oleh <strong class="text-floral-dark font-semibold">Niken Hartanti</strong> (Owner & Florist) dengan visi menghadirkan seni merangkai bunga yang penuh ketulusan, keindahan, dan estetika mendalam untuk setiap perayaan di Karawang & sekitarnya.
        </p>

        <!-- 4 Core Pillars -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="p-3 rounded-2xl bg-floral-pink-50/70 border border-floral-pink-200/70 text-center">
            <span class="text-xl block mb-1">💐</span>
            <span class="text-xs font-bold text-floral-dark block">Bouquet</span>
            <span class="text-[10px] text-floral-muted">Fresh & Artificial</span>
          </div>
          <div class="p-3 rounded-2xl bg-floral-pink-50/70 border border-floral-pink-200/70 text-center">
            <span class="text-xl block mb-1">🎁</span>
            <span class="text-xs font-bold text-floral-dark block">Gift</span>
            <span class="text-[10px] text-floral-muted">Kado & Hampers</span>
          </div>
          <div class="p-3 rounded-2xl bg-floral-gold-50/80 border border-floral-gold-200 text-center">
            <span class="text-xl block mb-1">👩‍🏫</span>
            <span class="text-xs font-bold text-floral-dark block">Class</span>
            <span class="text-[10px] text-floral-muted">Floral Workshop</span>
          </div>
          <div class="p-3 rounded-2xl bg-floral-pink-50/70 border border-floral-pink-200/70 text-center">
            <span class="text-xl block mb-1">🎀</span>
            <span class="text-xs font-bold text-floral-dark block">Decor</span>
            <span class="text-[10px] text-floral-muted">Seserahan & Event</span>
          </div>
        </div>

        <p class="text-sm sm:text-base text-floral-muted leading-relaxed mb-8">
          Berawal dari kecintaan terhadap seni floral, kami mengutamakan pemilihan bunga berkualitas, ketelitian perangkaian, kemudahan konsultasi personal, serta komitmen mengantarkan kebahagiaan tepat waktu.
        </p>

        <!-- Values checklist -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-floral-pink-100">
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-floral-pink-100 text-floral-pink-600 flex items-center justify-center shrink-0 mt-0.5 text-sm">
              ✓
            </div>
            <div>
              <h4 class="text-sm font-semibold text-floral-dark">Kualitas Bunga Terpilih</h4>
              <p class="text-xs text-floral-muted mt-0.5">Segar dan dirangkai secara profesional oleh florist berpengalaman.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-floral-gold-200 text-floral-gold-700 flex items-center justify-center shrink-0 mt-0.5 text-sm">
              ✓
            </div>
            <div>
              <h4 class="text-sm font-semibold text-floral-dark">Pemesanan & Konsultasi Ramah</h4>
              <p class="text-xs text-floral-muted mt-0.5">Konsultasi cepat via WhatsApp langsung dengan tim kami.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
