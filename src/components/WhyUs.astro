---
const benefits = [
  {
    title: 'Fresh & Beautiful',
    description: 'Bunga segar berkualitas tinggi yang dipilih secara teliti agar tetap mekar memukau di hari spesial Anda.',
    iconPath: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z'
  },
  {
    title: 'Beragam Pilihan',
    description: 'Menyediakan bouquet bunga segar, artificial everlasting, bloom box, standing flower, hingga gift kreatif.',
    iconPath: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z'
  },
  {
    title: 'Bisa Disesuaikan (Custom)',
    description: 'Bebas menentukan pilihan tema warna, jenis bunga, model wrapping, hingga penyesuaian budget yang fleksibel.',
    iconPath: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4'
  },
  {
    title: 'Local Florist Karawang',
    description: 'Berlokasi strategis di Telukjambe Karawang dengan layanan pengiriman cepat, aman, dan tepat waktu.',
    iconPath: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z'
  }
];
---

<section id="why-us" class="py-24 bg-floral-warm/40 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4">
        Why Candyzflorist?
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-4">
        Alasan Memilih Rangkaian Kami
      </h2>
      <p class="text-base sm:text-lg text-floral-muted">
        Kepuasan dan senyum kebahagiaan Anda adalah prioritas utama dari setiap karya yang kami buat.
      </p>
    </div>

    <!-- 4 Benefits Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {benefits.map((item) => (
        <div class="bg-white rounded-3xl p-8 shadow-soft hover:shadow-soft-lg border border-floral-pink-100/70 hover:border-floral-pink-300 transition-all duration-300 flex flex-col items-center text-center group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl bg-floral-pink-50 group-hover:bg-floral-pink-100 flex items-center justify-center mb-6 group-hover:scale-110 transition-all duration-300 text-floral-pink-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath} />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-floral-dark mb-3 group-hover:text-floral-pink-600 transition-colors">
            {item.title}
          </h3>
          <p class="text-sm text-floral-muted leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
