---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { fetchCategories, fetchProducts, fetchStoreSettings } from '../../lib/api';

const storeSettings = await fetchStoreSettings();
const waNumber = storeSettings.whatsapp ? storeSettings.whatsapp.replace(/^0/, '62') : '6289688035866';

// Ambil kategori secara dinamis dari database backend Golang
const categories = await fetchCategories();
const apiProducts = await fetchProducts();

const priceRanges = [
  { id: 'under-100', label: 'Di bawah Rp100.000' },
  { id: '100-200', label: 'Rp100.000 – Rp200.000' },
  { id: '200-500', label: 'Rp200.000 – Rp500.000' },
  { id: 'over-500', label: 'Di atas Rp500.000' },
];

// Ambil produk murni dari database backend
const allProducts = apiProducts || [];

const formatPrice = (price: number) => {
  if (!price || isNaN(price)) return 'Rp 0';
  return `Rp ${Number(price).toLocaleString('id-ID')}`;
};
---

<Layout
  title="Katalog Produk | Candyzflorist Karawang"
  description="Temukan koleksi lengkap bouquet, gift, dekorasi bunga dari Candyzflorist Karawang."
>
  <Navbar />

  <main class="pt-24 pb-20">
    <section class="py-10 sm:py-12 bg-floral-cream/50 min-h-screen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================= -->

        <div class="max-w-2xl mb-8 sm:mb-10">
          <div
            class="inline-flex items-center px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4"
          >
            Katalog Lengkap
          </div>

          <h1
            class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-3"
          >
            Katalog Produk
          </h1>

          <p class="text-sm sm:text-base text-floral-muted leading-relaxed">
            Temukan koleksi rangkaian bunga dan gift dari Candyzflorist.
            Hubungi kami untuk informasi harga dan ketersediaan.
          </p>
        </div>


        <!-- ================================= -->
        <!-- MOBILE FILTER BUTTON -->
        <!-- ================================= -->

        <div class="lg:hidden mb-5">
          <button
            id="open-filter"
            type="button"
            class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border border-floral-pink-200 rounded-xl text-sm font-semibold text-floral-dark shadow-sm hover:border-floral-pink-400 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
              />
            </svg>

            <span>Filter Produk</span>

            <span
              id="mobile-filter-count"
              class="hidden min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-floral-pink-600 text-white text-[10px]"
            >
            </span>
          </button>
        </div>


        <!-- ================================= -->
        <!-- CONTENT -->
        <!-- ================================= -->

        <div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">


          <!-- ================================= -->
          <!-- SIDEBAR / FILTER -->
          <!-- ================================= -->

          <aside
            id="filter-sidebar"
            class="
              fixed inset-0 z-50 hidden
              lg:static lg:block
              lg:z-auto
            "
          >

            <!-- Mobile Overlay -->
            <div
              id="filter-overlay"
              class="absolute inset-0 bg-black/30 lg:hidden"
            ></div>


            <!-- Filter Panel -->
            <div
              class="
                absolute right-0 top-0 h-full w-[85%] max-w-sm
                bg-white overflow-y-auto
                lg:static lg:w-auto lg:max-w-none
                lg:h-auto lg:overflow-visible
                lg:bg-white lg:rounded-2xl
                lg:border lg:border-gray-100
                lg:shadow-sm
              "
            >

              <!-- Filter Header -->
              <div
                class="sticky top-0 z-10 bg-white border-b border-gray-100 px-5 py-4 lg:static"
              >
                <div class="flex items-center justify-between">

                  <div>
                    <h2 class="font-semibold text-floral-dark">
                      Filter
                    </h2>

                    <p class="text-xs text-floral-muted mt-0.5">
                      Pilih sesuai kebutuhan
                    </p>
                  </div>

                  <!-- Mobile Close -->
                  <button
                    id="close-filter"
                    type="button"
                    class="lg:hidden p-2 -mr-2 text-gray-400 hover:text-floral-dark"
                    aria-label="Tutup filter"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-5 h-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                  </button>

                </div>
              </div>


              <!-- Filter Body -->
              <div class="p-5">


                <!-- ======================== -->
                <!-- KOLEKSI -->
                <!-- ======================== -->

                <div class="mb-7">

                  <h3
                    class="text-sm font-semibold text-floral-dark mb-4"
                  >
                    Koleksi
                  </h3>

                  <div class="space-y-3">

                    {categories.map((category) => (
                      <label
                        class="flex items-start gap-3 cursor-pointer group"
                      >
                        <input
                          type="checkbox"
                          name="category"
                          value={category.id}
                          class="category-checkbox mt-0.5 w-4 h-4 shrink-0 accent-floral-pink-600 rounded"
                        />

                        <span
                          class="text-sm text-floral-muted leading-snug group-hover:text-floral-pink-600 transition-colors"
                        >
                          {category.label}
                        </span>
                      </label>
                    ))}

                  </div>

                </div>


                <!-- ======================== -->
                <!-- HARGA -->
                <!-- ======================== -->

                <div class="pt-6 border-t border-gray-100">

                  <h3
                    class="text-sm font-semibold text-floral-dark mb-4"
                  >
                    Rentang Harga
                  </h3>

                  <div class="space-y-3">

                    {priceRanges.map((range) => (
                      <label
                        class="flex items-start gap-3 cursor-pointer group"
                      >
                        <input
                          type="checkbox"
                          name="price"
                          value={range.id}
                          class="price-checkbox mt-0.5 w-4 h-4 shrink-0 accent-floral-pink-600 rounded"
                        />

                        <span
                          class="text-sm text-floral-muted leading-snug group-hover:text-floral-pink-600 transition-colors"
                        >
                          {range.label}
                        </span>
                      </label>
                    ))}

                  </div>

                </div>


                <!-- ======================== -->
                <!-- RESET -->
                <!-- ======================== -->

                <button
                  id="reset-filter"
                  type="button"
                  class="w-full mt-8 py-2.5 px-4 rounded-lg border border-floral-pink-200 text-floral-pink-600 hover:bg-floral-pink-50 text-sm font-semibold transition-colors"
                >
                  Reset Filter
                </button>

              </div>


              <!-- Mobile Apply -->
              <div
                class="sticky bottom-0 bg-white border-t border-gray-100 p-4 lg:hidden"
              >
                <button
                  id="apply-filter"
                  type="button"
                  class="w-full py-3 rounded-xl bg-floral-pink-600 hover:bg-floral-pink-700 text-white text-sm font-semibold transition-colors"
                >
                  Tampilkan Produk
                </button>
              </div>

            </div>

          </aside>


          <!-- ================================= -->
          <!-- PRODUCT AREA -->
          <!-- ================================= -->

          <div class="min-w-0">


            <!-- Result Info -->
            <div
              class="flex items-center justify-between mb-5"
            >
              <p class="text-sm text-floral-muted">
                <span
                  id="product-count"
                  class="font-semibold text-floral-dark"
                >
                  {allProducts.length}
                </span>
                produk ditemukan
              </p>

              <button
                id="desktop-reset"
                type="button"
                class="hidden lg:block text-sm font-medium text-floral-pink-600 hover:text-floral-pink-700"
              >
                Reset filter
              </button>
            </div>


            <!-- ================================= -->
            <!-- PRODUCT GRID -->
            <!-- ================================= -->

            <div
              id="product-grid"
              class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5"
            >

              {allProducts.map((product) => {

                const productWaText = encodeURIComponent(
                  `Halo Candyzflorist, saya tertarik pesan produk: *${product.name}*. Boleh info ketersediaan dan harganya?`
                );

                const productWaLink =
                  `https://wa.me/${waNumber}?text=${productWaText}`;

                return (
                  <div
                    class="product-card cursor-pointer bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 flex flex-col group hover:-translate-y-1"
                    data-category={product.category}
                    data-price={product.price}
                    data-product={JSON.stringify(product)}
                  >

                    <!-- Image (3:4 Portrait) -->
                    <div class="aspect-[3/4] overflow-hidden bg-floral-pink-50 relative">

                      <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />

                      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                        <span class="px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-xs text-floral-dark text-[11px] font-semibold shadow-xs pointer-events-none">
                          Lihat Detail
                        </span>
                      </div>

                    </div>


                    <!-- Info -->
                    <div class="p-3 sm:p-4 flex flex-col gap-1">

                      <h3
                        class="font-sans text-xs sm:text-sm font-medium text-floral-dark leading-snug line-clamp-2 min-h-[2.5rem]"
                      >
                        {product.name}
                      </h3>

                      <p
                        class="text-floral-pink-600 font-semibold text-xs sm:text-sm"
                      >
                        {formatPrice(product.price)}
                      </p>


                      <!-- WA -->
                      <a
                        href={productWaLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-2 sm:px-3 rounded-md bg-floral-pink-100 hover:bg-floral-pink-500 text-floral-pink-700 hover:text-white font-semibold text-[10px] sm:text-xs transition-all duration-300 mt-1.5"
                      >

                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-3 h-3 shrink-0 fill-current"
                          viewBox="0 0 24 24"
                        >
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.669-.967-.941 1.165-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                        </svg>

                        <span>Pesan via WA</span>

                      </a>

                    </div>

                  </div>
                );
              })}

            </div>


            <!-- ================================= -->
            <!-- PAGINATION CONTAINER -->
            <!-- ================================= -->

            <div
              id="pagination-container"
              class="mt-10 pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4"
            >
              <p
                id="pagination-info"
                class="text-xs sm:text-sm text-floral-muted font-medium text-center sm:text-left"
              >
                Menampilkan 1 – 12 dari 48 produk
              </p>

              <div
                id="pagination-controls"
                class="flex items-center gap-1.5 flex-wrap justify-center"
              >
                <!-- Dynamic Page Buttons inserted by JS -->
              </div>
            </div>


            <!-- ================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================= -->

            <div
              id="empty-state"
              class="hidden text-center py-20 text-floral-muted"
            >

              <div class="flex justify-center mb-4 text-floral-pink-300">

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-12 h-12"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0H4"
                  />
                </svg>

              </div>

              <p class="font-medium text-floral-dark">
                Tidak ada produk yang sesuai.
              </p>

              <p class="text-sm mt-1">
                Coba ubah kategori atau rentang harga.
              </p>

            </div>

          </div>

        </div>

      </div>
    </section>
  </main>

  <!-- ================================= -->
  <!-- ================================= -->
  <!-- PRODUCT DETAIL MODAL (RESPONSIVE) -->
  <!-- ================================= -->
  <div
    id="product-modal"
    data-wa-number={waNumber}
    class="fixed inset-0 z-50 hidden items-center justify-center p-2.5 sm:p-5 md:p-6 bg-black/70 backdrop-blur-xs transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <!-- Modal Backdrop Overlay -->
    <div id="modal-backdrop" class="absolute inset-0"></div>

    <div
      class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-floral-pink-100 overflow-hidden z-10 flex flex-col max-h-[86vh] sm:max-h-[88vh] my-auto"
    >
      <!-- Close Floating Button -->
      <button
        id="modal-close-btn"
        type="button"
        class="absolute top-3 right-3 sm:top-4 sm:right-4 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/95 backdrop-blur-xs hover:bg-floral-pink-50 text-floral-dark hover:text-floral-pink-600 shadow-md border border-floral-pink-100 flex items-center justify-center transition-all duration-200"
        aria-label="Tutup"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Scrollable Modal Body -->
      <div class="overflow-y-auto overscroll-contain flex-1 p-4 sm:p-6 lg:p-7">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 sm:gap-7 items-start">
          
          <!-- Left: Image Slider (3:4 Portrait) -->
          <div class="sm:col-span-5 flex flex-col items-center gap-2.5">
            <div class="relative w-full max-w-[220px] sm:max-w-none aspect-[3/4] mx-auto rounded-2xl overflow-hidden bg-floral-pink-50 border border-floral-pink-100 shadow-inner group select-none">
              
              <!-- Slides Container -->
              <div id="modal-slider-track" class="w-full h-full flex transition-transform duration-300 ease-out">
                <!-- Dynamically populated <img> elements -->
              </div>

              <!-- Prev / Next Navigation buttons -->
              <button
                id="modal-prev-btn"
                type="button"
                class="hidden absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-xs text-floral-dark hover:bg-floral-pink-500 hover:text-white shadow-md items-center justify-center transition-all z-20"
                aria-label="Foto sebelumnya"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <button
                id="modal-next-btn"
                type="button"
                class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-xs text-floral-dark hover:bg-floral-pink-500 hover:text-white shadow-md items-center justify-center transition-all z-20"
                aria-label="Foto berikutnya"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <!-- Image Index Badge -->
              <div
                id="modal-image-counter"
                class="hidden absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-xs text-white text-[11px] font-semibold tracking-wider z-20"
              >
                1 / 1
              </div>
            </div>

            <!-- Thumbnail Strip (if multiple images) -->
            <div id="modal-thumbnails" class="hidden flex items-center justify-center gap-2 w-full overflow-x-auto py-1">
              <!-- Dynamically created small thumbnails -->
            </div>
          </div>

          <!-- Right: Product Information & CTA -->
          <div class="sm:col-span-7 flex flex-col justify-between space-y-4 pb-2">
            <div class="space-y-2.5 sm:space-y-3">
              <!-- Category Badge -->
              <div id="modal-categories" class="flex flex-wrap gap-1.5 items-center">
                <!-- Dynamically populated category tags -->
              </div>

              <!-- Product Title -->
              <h3
                id="modal-title"
                class="font-serif text-lg sm:text-2xl font-bold text-floral-dark leading-tight pr-8 sm:pr-0"
              ></h3>

              <!-- Price -->
              <div class="flex items-baseline gap-2">
                <span
                  id="modal-price"
                  class="text-lg sm:text-2xl font-bold text-floral-pink-600"
                ></span>
              </div>

              <!-- Divider -->
              <div class="border-t border-floral-pink-100/80 my-2"></div>

              <!-- Description -->
              <div class="space-y-1">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-floral-dark/70">
                  Deskripsi Produk
                </h4>
                <p
                  id="modal-description"
                  class="text-xs sm:text-sm text-floral-muted leading-relaxed whitespace-pre-line"
                >
                  Rangkaian bunga eksklusif berkualitas tinggi dari Candyzflorist Karawang.
                </p>
              </div>
            </div>

            <!-- WhatsApp Order Action Button -->
            <div class="pt-3 sm:pt-4 border-t border-floral-pink-100/80">
              <a
                id="modal-wa-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2.5 py-3 px-5 sm:py-3.5 sm:px-6 rounded-2xl bg-gradient-to-r from-floral-pink-500 to-floral-pink-600 hover:from-floral-pink-600 hover:to-floral-pink-700 text-white font-semibold text-sm sm:text-base shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Pesan Sekarang via WhatsApp</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>


<script>
  /*
   * ==========================================
   * ELEMENTS
   * ==========================================
   */

  const categoryCheckboxes =
    document.querySelectorAll<HTMLInputElement>(
      '.category-checkbox'
    );

  const priceCheckboxes =
    document.querySelectorAll<HTMLInputElement>(
      '.price-checkbox'
    );

  const productCards =
    document.querySelectorAll<HTMLElement>(
      '.product-card'
    );

  const productCount =
    document.getElementById('product-count');

  const emptyState =
    document.getElementById('empty-state');

  const paginationContainer =
    document.getElementById('pagination-container');

  const paginationInfo =
    document.getElementById('pagination-info');

  const paginationControls =
    document.getElementById('pagination-controls');

  const resetFilter =
    document.getElementById('reset-filter');

  const desktopReset =
    document.getElementById('desktop-reset');

  const mobileFilterCount =
    document.getElementById('mobile-filter-count');

  const filterSidebar =
    document.getElementById('filter-sidebar');

  const filterOverlay =
    document.getElementById('filter-overlay');

  const openFilter =
    document.getElementById('open-filter');

  const closeFilter =
    document.getElementById('close-filter');

  const applyFilter =
    document.getElementById('apply-filter');

  /*
   * ==========================================
   * PAGINATION CONFIG
   * ==========================================
   */

  let currentPage = 1;
  const itemsPerPage = 12;

  /*
   * ==========================================
   * GET SELECTED FILTER
   * ==========================================
   */

  function getSelectedCategories(): string[] {
    return Array.from(categoryCheckboxes)
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value);
  }

  function getSelectedPrices(): string[] {
    return Array.from(priceCheckboxes)
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value);
  }

  /*
   * ==========================================
   * PRICE MATCH
   * ==========================================
   */

  function matchPrice(
    price: number,
    ranges: string[]
  ): boolean {
    if (ranges.length === 0) {
      return true;
    }

    return ranges.some((range) => {
      switch (range) {
        case 'under-100':
          return price < 100000;
        case '100-200':
          return price >= 100000 && price <= 200000;
        case '200-500':
          return price > 200000 && price <= 500000;
        case 'over-500':
          return price > 500000;
        default:
          return false;
      }
    });
  }

  /*
   * ==========================================
   * RENDER PAGINATION BUTTONS
   * ==========================================
   */

  function renderPagination(totalVisible: number) {
    if (!paginationControls || !paginationContainer || !paginationInfo) return;

    const totalPages = Math.ceil(totalVisible / itemsPerPage);

    if (totalVisible === 0 || totalPages <= 1) {
      paginationContainer.classList.add('hidden');
      return;
    }

    paginationContainer.classList.remove('hidden');

    const start = (currentPage - 1) * itemsPerPage + 1;
    const end = Math.min(currentPage * itemsPerPage, totalVisible);
    paginationInfo.textContent = `Menampilkan ${start} – ${end} dari ${totalVisible} produk (Halaman ${currentPage} dari ${totalPages})`;

    paginationControls.innerHTML = '';

    // Prev Button
    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.disabled = currentPage <= 1;
    prevBtn.className = `p-2 rounded-lg border border-floral-pink-200 text-floral-dark hover:bg-floral-pink-50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed`;
    prevBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    `;
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        filterProducts();
        document.getElementById('product-grid')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
    paginationControls.appendChild(prevBtn);

    // Page Buttons
    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        const isCurrent = i === currentPage;
        pageBtn.className = `min-w-8 h-8 px-2.5 rounded-lg text-xs font-bold transition-all ${
          isCurrent
            ? 'bg-floral-pink-600 text-white shadow-sm'
            : 'border border-floral-pink-200 text-floral-dark hover:bg-floral-pink-50'
        }`;
        pageBtn.textContent = String(i);
        pageBtn.addEventListener('click', () => {
          currentPage = i;
          filterProducts();
          document.getElementById('product-grid')?.scrollIntoView({ behavior: 'smooth' });
        });
        paginationControls.appendChild(pageBtn);
      } else if (
        (i === currentPage - 2 && i > 1) ||
        (i === currentPage + 2 && i < totalPages)
      ) {
        const ellipsis = document.createElement('span');
        ellipsis.className = 'px-1.5 text-xs text-floral-muted';
        ellipsis.textContent = '...';
        paginationControls.appendChild(ellipsis);
      }
    }

    // Next Button
    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.disabled = currentPage >= totalPages;
    nextBtn.className = `p-2 rounded-lg border border-floral-pink-200 text-floral-dark hover:bg-floral-pink-50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed`;
    nextBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    `;
    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        filterProducts();
        document.getElementById('product-grid')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
    paginationControls.appendChild(nextBtn);
  }

  /*
   * ==========================================
   * FILTER PRODUCTS WITH PAGINATION
   * ==========================================
   */

  function filterProducts() {
    const selectedCategories = getSelectedCategories();
    const selectedPrices = getSelectedPrices();

    const matchedCards: HTMLElement[] = [];

    productCards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const price = Number(card.dataset.price ?? 0);

      const categoryMatch =
        selectedCategories.length === 0 || selectedCategories.includes(category);
      const priceMatch = matchPrice(price, selectedPrices);

      if (categoryMatch && priceMatch) {
        matchedCards.push(card);
      } else {
        card.style.display = 'none';
      }
    });

    const totalVisible = matchedCards.length;
    const totalPages = Math.ceil(totalVisible / itemsPerPage) || 1;
    if (currentPage > totalPages) {
      currentPage = totalPages;
    }

    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;

    matchedCards.forEach((card, index) => {
      if (index >= startIndex && index < endIndex) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });

    if (productCount) {
      productCount.textContent = String(totalVisible);
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', totalVisible > 0);
    }

    renderPagination(totalVisible);

    // Mobile filter badge
    const totalFilters = selectedCategories.length + selectedPrices.length;
    if (mobileFilterCount) {
      if (totalFilters > 0) {
        mobileFilterCount.textContent = String(totalFilters);
        mobileFilterCount.classList.remove('hidden');
        mobileFilterCount.classList.add('inline-flex');
      } else {
        mobileFilterCount.classList.add('hidden');
        mobileFilterCount.classList.remove('inline-flex');
      }
    }
  }

  /*
   * ==========================================
   * CHECKBOX EVENTS
   * ==========================================
   */

  categoryCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      currentPage = 1;
      filterProducts();
    });
  });

  priceCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      currentPage = 1;
      filterProducts();
    });
  });

  /*
   * ==========================================
   * RESET
   * ==========================================
   */

  function resetFilters() {
    categoryCheckboxes.forEach((checkbox) => {
      checkbox.checked = false;
    });

    priceCheckboxes.forEach((checkbox) => {
      checkbox.checked = false;
    });

    currentPage = 1;
    filterProducts();
  }

  resetFilter?.addEventListener('click', resetFilters);
  desktopReset?.addEventListener('click', resetFilters);

  /*
   * ==========================================
   * MOBILE FILTER
   * ==========================================
   */

  function openFilterPanel() {
    filterSidebar?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }

  function closeFilterPanel() {
    filterSidebar?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  openFilter?.addEventListener('click', openFilterPanel);
  closeFilter?.addEventListener('click', closeFilterPanel);
  filterOverlay?.addEventListener('click', closeFilterPanel);
  applyFilter?.addEventListener('click', closeFilterPanel);

  /*
   * ==========================================
   * PRODUCT DETAIL MODAL & IMAGE SLIDER
   * ==========================================
   */

  const productModal = document.getElementById('product-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalSliderTrack = document.getElementById('modal-slider-track');
  const modalPrevBtn = document.getElementById('modal-prev-btn');
  const modalNextBtn = document.getElementById('modal-next-btn');
  const modalImageCounter = document.getElementById('modal-image-counter');
  const modalThumbnails = document.getElementById('modal-thumbnails');
  const modalTitle = document.getElementById('modal-title');
  const modalPrice = document.getElementById('modal-price');
  const modalCategories = document.getElementById('modal-categories');
  const modalDescription = document.getElementById('modal-description');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement | null;

  let modalImages: string[] = [];
  let modalSlideIndex = 0;

  function updateModalSlider() {
    if (!modalSliderTrack) return;
    modalSliderTrack.style.transform = `translateX(-${modalSlideIndex * 100}%)`;

    if (modalImageCounter) {
      modalImageCounter.textContent = `${modalSlideIndex + 1} / ${modalImages.length}`;
    }

    if (modalThumbnails) {
      Array.from(modalThumbnails.children).forEach((thumb, idx) => {
        if (idx === modalSlideIndex) {
          thumb.classList.add('ring-2', 'ring-floral-pink-500', 'opacity-100');
          thumb.classList.remove('opacity-60');
        } else {
          thumb.classList.remove('ring-2', 'ring-floral-pink-500', 'opacity-100');
          thumb.classList.add('opacity-60');
        }
      });
    }
  }

  function goToModalSlide(index: number) {
    if (modalImages.length <= 1) return;
    if (index < 0) {
      modalSlideIndex = modalImages.length - 1;
    } else if (index >= modalImages.length) {
      modalSlideIndex = 0;
    } else {
      modalSlideIndex = index;
    }
    updateModalSlider();
  }

  modalPrevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    goToModalSlide(modalSlideIndex - 1);
  });

  modalNextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    goToModalSlide(modalSlideIndex + 1);
  });

  // Mobile Touch Swipe Support
  let touchStartX = 0;
  let touchEndX = 0;

  modalSliderTrack?.parentElement?.addEventListener(
    'touchstart',
    (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  modalSliderTrack?.parentElement?.addEventListener(
    'touchend',
    (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          goToModalSlide(modalSlideIndex + 1);
        } else {
          goToModalSlide(modalSlideIndex - 1);
        }
      }
    },
    { passive: true }
  );

  function openModalWithProduct(product: any) {
    if (!productModal) return;

    modalImages = Array.isArray(product.images) && product.images.length > 0
      ? product.images
      : (product.image ? [product.image] : []);

    modalSlideIndex = 0;

    // Populate Slide Track
    if (modalSliderTrack) {
      modalSliderTrack.innerHTML = '';
      modalImages.forEach((imgSrc: string) => {
        const slide = document.createElement('div');
        slide.className = 'w-full h-full shrink-0 flex items-center justify-center bg-floral-pink-50';
        slide.innerHTML = `<img src="${imgSrc}" alt="${product.name || 'Produk'}" class="w-full h-full object-cover" />`;
        modalSliderTrack.appendChild(slide);
      });
    }

    const hasMultiple = modalImages.length > 1;
    modalPrevBtn?.classList.toggle('hidden', !hasMultiple);
    modalPrevBtn?.classList.toggle('flex', hasMultiple);
    modalNextBtn?.classList.toggle('hidden', !hasMultiple);
    modalNextBtn?.classList.toggle('flex', hasMultiple);
    modalImageCounter?.classList.toggle('hidden', !hasMultiple);

    // Thumbnails Strip
    if (modalThumbnails) {
      modalThumbnails.innerHTML = '';
      if (hasMultiple) {
        modalThumbnails.classList.remove('hidden');
        modalImages.forEach((imgSrc: string, idx: number) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-11 h-14 sm:w-12 sm:h-16 shrink-0 aspect-[3/4] rounded-lg overflow-hidden border border-floral-pink-200 transition-all cursor-pointer';
          btn.innerHTML = `<img src="${imgSrc}" class="w-full h-full object-cover" />`;
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            goToModalSlide(idx);
          });
          modalThumbnails.appendChild(btn);
        });
      } else {
        modalThumbnails.classList.add('hidden');
      }
    }

    updateModalSlider();

    // Populate Title & Price
    if (modalTitle) {
      modalTitle.textContent = product.name || 'Detail Produk';
    }

    if (modalPrice) {
      const pNum = Number(product.price || 0);
      modalPrice.textContent = `Rp ${pNum.toLocaleString('id-ID')}`;
    }

    // Populate Category Badges
    if (modalCategories) {
      modalCategories.innerHTML = '';
      const labels = Array.isArray(product.categoryLabels) && product.categoryLabels.length > 0
        ? product.categoryLabels
        : (product.category ? [product.category] : []);

      labels.forEach((lbl: string) => {
        const span = document.createElement('span');
        span.className = 'px-3 py-1 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold capitalize border border-floral-pink-200/80';
        span.textContent = lbl.replace(/-/g, ' ');
        modalCategories.appendChild(span);
      });
    }

    // Populate Description
    if (modalDescription) {
      modalDescription.textContent = product.deskripsi && product.deskripsi.trim() !== ''
        ? product.deskripsi
        : 'Rangkaian bunga eksklusif berkualitas tinggi dari Candyzflorist Karawang. Dirangkai rapi dengan bunga pilihan dan wrapping elegan.';
    }

    // WhatsApp Action Button Link
    if (modalWaBtn) {
      const waNum = productModal?.dataset.waNumber || '6289688035866';
      const waText = encodeURIComponent(
        `Halo Candyzflorist, saya tertarik untuk memesan produk: *${product.name}*. Boleh info ketersediaan dan detail pesanannya?`
      );
      modalWaBtn.href = `https://wa.me/${waNum}?text=${waText}`;
    }

    // Open Modal
    productModal.classList.remove('hidden');
    productModal.classList.add('flex');
    const scrollBody = productModal.querySelector('.overflow-y-auto');
    if (scrollBody) scrollBody.scrollTop = 0;
    document.body.classList.add('overflow-hidden');
  }

  function closeProductModal() {
    if (!productModal) return;
    productModal.classList.add('hidden');
    productModal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  modalCloseBtn?.addEventListener('click', closeProductModal);
  modalBackdrop?.addEventListener('click', closeProductModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && productModal && !productModal.classList.contains('hidden')) {
      closeProductModal();
    }
  });

  // Attach Click Listener to Each Product Card
  productCards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // If user directly clicked the "Pesan via WA" link, allow direct navigation
      if ((e.target as HTMLElement).closest('a')) {
        return;
      }

      const raw = card.dataset.product;
      if (raw) {
        try {
          const product = JSON.parse(raw);
          openModalWithProduct(product);
        } catch (err) {
          console.error('Error parsing product data:', err);
        }
      }
    });
  });

  /*
   * ==========================================
   * INITIAL FILTER
   * ==========================================
   */

  filterProducts();
</script>