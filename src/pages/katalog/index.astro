---

<Layout title="Katalog Produk | Candyzflorist Karawang" description="Temukan koleksi lengkap bouquet, gift, dekorasi bunga dari Candyzflorist Karawang.">
  <Navbar />
  
  <main class="pt-24 pb-20">
    <section class="py-12 bg-floral-cream/50 min-h-screen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Page Header -->
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-pink-100 text-floral-pink-700 text-xs font-semibold uppercase tracking-wider mb-4">
            Katalog Lengkap
          </div>
          <h1 class="font-serif text-4xl lg:text-5xl font-bold text-floral-dark mb-3">
            Katalog Produk
          </h1>
          <p class="text-base text-floral-muted">
            Temukan koleksi lengkap rangkaian bunga terbaik kami. Hubungi kami untuk info harga dan ketersediaan.
          </p>
        </div>

        <!-- Category Filter Tabs -->
        <div class="flex flex-wrap justify-center gap-2 mb-10" id="category-tabs">
          {categories.map((cat) => (
            <button
              data-category={cat.id}
              class={`category-btn px-4 py-2 rounded-full text-sm font-semibold border transition-all duration-200 ${cat.id === 'semua' ? 'bg-floral-pink-600 text-white border-floral-pink-600' : 'bg-white text-floral-dark border-floral-pink-200 hover:border-floral-pink-400 hover:text-floral-pink-600'}`}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5" id="product-grid">
          {products.map((product) => {
            const productWaText = encodeURIComponent(`Halo Candyzflorist, saya tertarik pesan produk: *${product.name}*. Boleh info ketersediaan dan harganya?`);
            const productWaLink = `https://wa.me/${waNumber}?text=${productWaText}`;

            return (
              <div
                class="product-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 flex flex-col group hover:-translate-y-1"
                data-category={product.category}
              >
                <!-- Image -->
                <div class="aspect-square overflow-hidden bg-floral-pink-50">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <!-- Info -->
                <div class="p-3 sm:p-4 flex flex-col gap-1">
                  <h3 class="font-sans text-xs sm:text-sm font-medium text-floral-dark leading-snug line-clamp-2 min-h-[2.5rem]">
                    {product.name}
                  </h3>
                  <p class="text-floral-pink-600 font-semibold text-sm">{product.price}</p>

                  <!-- WA Button -->
                  <a
                    href={productWaLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-md bg-floral-pink-100 hover:bg-floral-pink-500 text-floral-pink-700 hover:text-white font-semibold text-[11px] sm:text-xs transition-all duration-300 mt-1.5"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                    <span>Pesan via WA</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <div id="empty-state" class="hidden text-center py-20 text-floral-muted">
          <div class="flex justify-center mb-3 text-floral-pink-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <p class="font-medium">Tidak ada produk di kategori ini saat ini.</p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const emptyState = document.getElementById('empty-state');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.dataset.category;

      // Update active tab style
      tabs.forEach((t) => {
        t.classList.remove('bg-floral-pink-600', 'text-white', 'border-floral-pink-600');
        t.classList.add('bg-white', 'text-floral-dark', 'border-floral-pink-200');
      });
      tab.classList.add('bg-floral-pink-600', 'text-white', 'border-floral-pink-600');
      tab.classList.remove('bg-white', 'text-floral-dark', 'border-floral-pink-200');

      // Filter cards
      let visible = 0;
      cards.forEach((card) => {
        if (selected === 'semua' || card.dataset.category === selected) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    });
  });
</script>
