---
const currentYear = new Date().getFullYear();
const waNumber = "6289688035866";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent("Halo Candyzflorist, saya ingin tanya/pesan rangkaian bunga.")}`;
---

<footer class="bg-floral-dark text-white pt-16 pb-12 border-t border-floral-pink-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Owner Identity -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full overflow-hidden border border-white/20 shadow-inner">
            <img src="/logo.jpg" alt="Candyzflorist Logo" class="w-full h-full object-cover" />
          </div>
          <div>
            <span class="font-serif text-2xl font-bold tracking-tight text-white block">
              Candyz<span class="text-floral-pink-400 font-normal">florist</span>
            </span>
            <span class="text-[11px] text-floral-gold-300 font-medium tracking-wider uppercase block">
              Bouquet • Gift • Class • Decor
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
          Florist studio di Karawang yang dipimpin oleh <strong class="text-white font-semibold">Niken Hartanti</strong> (Owner & Florist). Menyediakan rangkaian bunga segar, kado istimewa, dekorasi, hingga flower class.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <!-- WhatsApp -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-green-600 flex items-center justify-center text-white transition-colors"
            title="WhatsApp"
            aria-label="WhatsApp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com/candyzflorist_"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-rose-600 flex items-center justify-center text-white transition-colors"
            title="Instagram @candyzflorist_"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@candyzflorist_?is_from_webapp=1&sender_device=pc"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-black flex items-center justify-center text-white transition-colors"
            title="TikTok @candyzflorist_"
            aria-label="TikTok"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.65 6.34 6.34 0 0 0 9.35 22a6.33 6.33 0 0 0 6.34-6.33V9.2a7.9 7.9 0 0 0 3.9 1.08V6.85a5.53 5.53 0 0 1 0-.16z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/company/candyzflorist/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#0077B5] flex items-center justify-center text-white transition-colors"
            title="LinkedIn Candyz Florist"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href="mailto:Candyzflorist.id@gmail.com"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-floral-pink-600 flex items-center justify-center text-white transition-colors"
            title="Email Candyzflorist.id@gmail.com"
            aria-label="Email"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-2">
        <h4 class="font-serif text-base font-bold text-white uppercase tracking-wider mb-4">
          Navigasi
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-gray-300">
          <li><a href="#home" class="hover:text-floral-pink-400 transition-colors">Home</a></li>
          <li><a href="#about" class="hover:text-floral-pink-400 transition-colors">Tentang Kami</a></li>
          <li><a href="#collection" class="hover:text-floral-pink-400 transition-colors">Koleksi Produk</a></li>
          <li><a href="#occasions" class="hover:text-floral-pink-400 transition-colors">Momen Spesial</a></li>
          <li><a href="#gallery" class="hover:text-floral-pink-400 transition-colors">Galeri Karya</a></li>
          <li><a href="#contact" class="hover:text-floral-pink-400 transition-colors">Lokasi & Kontak</a></li>
        </ul>
      </div>

      <!-- Services & Offerings -->
      <div class="lg:col-span-3">
        <h4 class="font-serif text-base font-bold text-white uppercase tracking-wider mb-4">
          Layanan & Karya
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-gray-300">
          <li>💐 Fresh & Artificial Bouquet</li>
          <li>🎁 Personalized Gift & Hampers</li>
          <li>👩‍🏫 Floral Workshop & Class</li>
          <li>🎀 Hantaran & Event Decor</li>
          <li>✨ Custom Floral Arrangement</li>
        </ul>
      </div>

      <!-- Studio Contact Info -->
      <div class="lg:col-span-3">
        <h4 class="font-serif text-base font-bold text-white uppercase tracking-wider mb-4">
          Kontak & Studio
        </h4>
        <div class="space-y-2.5 text-xs sm:text-sm text-gray-300 leading-relaxed">
          <p class="text-white font-medium">Candyz Florist Karawang</p>
          <p class="text-gray-400">Blok F No.528, Perumnas bumi, Telukjambe Timur, Karawang 41361</p>
          <p class="text-floral-pink-300 font-semibold">+62 896-8803-5866</p>
          <p class="text-gray-400">Candyzflorist.id@gmail.com</p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>© {currentYear} Candyzflorist Karawang • Niken Hartanti. All rights reserved.</p>
      <p class="flex items-center gap-1 text-floral-pink-300">
        Bouquet | Gift | Class | Decor
      </p>
    </div>

  </div>
</footer>

