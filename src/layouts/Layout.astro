---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Candyzflorist | Florist Karawang - Bunga untuk Setiap Momen Spesial",
  description = "Florist terpercaya di Karawang menyediakan bouquet fresh flower, artificial flower, flower arrangement, hantaran dan dekorasi untuk berbagai momen spesial."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-floral-cream text-floral-dark selection:bg-floral-pink-200 selection:text-floral-pink-700 antialiased min-h-screen overflow-x-hidden">
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.config({
        ignoreMobileResize: true,
        autoRefreshEvents: 'visibilitychange,DOMContentLoaded,load',
      });

      const isTouch = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!isTouch && !prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      }

      function initInteractiveAnimations() {
        if (prefersReducedMotion) return;

        // 1. Navbar Scroll Progress Bar & Compact State
        const progressBar = document.getElementById('scroll-progress-bar');
        const navbar = document.getElementById('navbar');
        const navbarInner = document.getElementById('navbar-inner');

        const updateScrollUI = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (progressBar && docHeight > 0) {
            const pct = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
            progressBar.style.width = `${pct}%`;
          }
          if (navbar && navbarInner) {
            if (scrollTop > 40) {
              navbar.classList.add('bg-white/95', 'shadow-md');
              navbar.classList.remove('bg-white/80', 'shadow-sm');
              navbarInner.classList.replace('h-20', 'h-16');
            } else {
              navbar.classList.remove('bg-white/95', 'shadow-md');
              navbar.classList.add('bg-white/80', 'shadow-sm');
              navbarInner.classList.replace('h-16', 'h-20');
            }
          }
        };
        window.addEventListener('scroll', updateScrollUI, { passive: true });
        updateScrollUI();

        // 2. Hero Entrance Animation
        const heroReveals = document.querySelectorAll('.hero-reveal');
        const heroTiltCard = document.getElementById('hero-tilt-card');
        const heroBadgeTop = document.getElementById('hero-badge-top');
        const heroBadgeBottom = document.getElementById('hero-badge-bottom');

        if (heroReveals.length > 0) {
          const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

          heroTl.from(heroReveals, {
            y: 35,
            opacity: 0,
            duration: 0.85,
            stagger: 0.12,
            clearProps: 'all',
          });

          if (heroTiltCard) {
            heroTl.from(
              heroTiltCard,
              {
                scale: 0.88,
                opacity: 0,
                rotationY: -10,
                y: 30,
                duration: 1,
                clearProps: 'opacity,scale',
              },
              '-=0.65'
            );
          }

          if (heroBadgeTop && heroBadgeBottom) {
            heroTl.from(
              [heroBadgeTop, heroBadgeBottom],
              {
                scale: 0.6,
                opacity: 0,
                y: 20,
                duration: 0.65,
                stagger: 0.15,
                ease: 'back.out(1.7)',
                clearProps: 'opacity,scale',
              },
              '-=0.5'
            );
          }
        }

        // 3. Hero Interactive Mouse Parallax & 3D Tilt (Desktop)
        const heroSection = document.getElementById('home');
        const heroBlob1 = document.getElementById('hero-blob-1');
        const heroBlob2 = document.getElementById('hero-blob-2');
        const heroPetals = document.querySelectorAll('.hero-petal');

        if (heroSection && !isTouch) {
          heroSection.addEventListener('mousemove', (e) => {
            const rect = heroSection.getBoundingClientRect();
            const relX = (e.clientX - rect.left) / rect.width - 0.5;
            const relY = (e.clientY - rect.top) / rect.height - 0.5;

            if (heroTiltCard) {
              gsap.to(heroTiltCard, {
                rotationY: relX * 14,
                rotationX: -relY * 14,
                transformPerspective: 1000,
                duration: 0.6,
                ease: 'power2.out',
              });
            }
            if (heroBadgeTop) {
              gsap.to(heroBadgeTop, {
                x: relX * 26,
                y: relY * 26,
                duration: 0.6,
                ease: 'power2.out',
              });
            }
            if (heroBadgeBottom) {
              gsap.to(heroBadgeBottom, {
                x: -relX * 22,
                y: -relY * 22,
                duration: 0.6,
                ease: 'power2.out',
              });
            }
            if (heroBlob1) {
              gsap.to(heroBlob1, { x: relX * 45, y: relY * 45, duration: 1.2, ease: 'power2.out' });
            }
            if (heroBlob2) {
              gsap.to(heroBlob2, { x: -relX * 45, y: -relY * 45, duration: 1.2, ease: 'power2.out' });
            }
            if (heroPetals.length > 0) {
              gsap.to(heroPetals, {
                x: (i) => (i % 2 === 0 ? relX * 30 : -relX * 30),
                y: (i) => (i % 2 === 0 ? relY * 30 : -relY * 30),
                rotation: relX * 25,
                duration: 0.9,
                ease: 'power2.out',
              });
            }
          });

          heroSection.addEventListener('mouseleave', () => {
            if (heroTiltCard) {
              gsap.to(heroTiltCard, { rotationY: 0, rotationX: 0, duration: 0.8, ease: 'elastic.out(1, 0.6)' });
            }
            if (heroBadgeTop && heroBadgeBottom) {
              gsap.to([heroBadgeTop, heroBadgeBottom], { x: 0, y: 0, duration: 0.8, ease: 'power3.out' });
            }
          });
        }

        // 4. Interactive 3D Card Tilt on [data-tilt]
        if (!isTouch) {
          const tiltCards = document.querySelectorAll<HTMLElement>('[data-tilt]');
          tiltCards.forEach((card) => {
            card.addEventListener('mousemove', (e) => {
              const rect = card.getBoundingClientRect();
              const x = (e.clientX - rect.left) / rect.width - 0.5;
              const y = (e.clientY - rect.top) / rect.height - 0.5;
              gsap.to(card, {
                rotationY: x * 10,
                rotationX: -y * 10,
                y: -6,
                transformPerspective: 900,
                duration: 0.4,
                ease: 'power2.out',
              });
            });
            card.addEventListener('mouseleave', () => {
              gsap.to(card, {
                rotationY: 0,
                rotationX: 0,
                y: 0,
                duration: 0.7,
                ease: 'elastic.out(1, 0.6)',
              });
            });
          });

          // 5. Magnetic Hover Effect on [data-magnetic]
          const magneticBtns = document.querySelectorAll<HTMLElement>('[data-magnetic]');
          magneticBtns.forEach((btn) => {
            btn.addEventListener('mousemove', (e) => {
              const rect = btn.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              gsap.to(btn, {
                x: x * 0.22,
                y: y * 0.28,
                duration: 0.35,
                ease: 'power2.out',
              });
            });
            btn.addEventListener('mouseleave', () => {
              gsap.to(btn, {
                x: 0,
                y: 0,
                duration: 0.7,
                ease: 'elastic.out(1, 0.5)',
              });
            });
          });
        }

        // 6. ScrollTrigger Section Headers
        gsap.utils.toArray<HTMLElement>('.section-header').forEach((header) => {
          gsap.from(header.children, {
            scrollTrigger: {
              trigger: header,
              start: 'top 85%',
              toggleActions: 'play none none none',
            },
            y: 30,
            opacity: 0,
            duration: 0.75,
            stagger: 0.12,
            ease: 'power3.out',
            clearProps: 'all',
          });
        });

        // 7. About Section Reveal + Number Counter
        const aboutSection = document.getElementById('about');
        if (aboutSection) {
          gsap.from('.about-card', {
            scrollTrigger: {
              trigger: aboutSection,
              start: 'top 80%',
            },
            y: 40,
            opacity: 0,
            scale: 0.94,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
            clearProps: 'all',
          });

          gsap.from('.about-reveal, .about-pillar', {
            scrollTrigger: {
              trigger: aboutSection,
              start: 'top 78%',
            },
            y: 28,
            opacity: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: 'power3.out',
            clearProps: 'all',
          });
        }

        // Animated Number Counter [data-counter]
        document.querySelectorAll<HTMLElement>('[data-counter]').forEach((counterEl) => {
          const targetVal = parseInt(counterEl.getAttribute('data-counter') || '100', 10);
          const obj = { val: 0 };
          ScrollTrigger.create({
            trigger: counterEl,
            start: 'top 88%',
            once: true,
            onEnter: () => {
              gsap.to(obj, {
                val: targetVal,
                duration: 2,
                ease: 'power2.out',
                onUpdate: () => {
                  counterEl.textContent = `${Math.round(obj.val)}+`;
                },
              });
            },
          });
        });

        // 8. Staggered Grid Reveals across Sections
        const revealGroups = [
          { trigger: '#collection-grid', selector: '#collection-grid .collection-card' },
          { trigger: '#occasions', selector: '#occasions .stagger-card' },
          { trigger: '#custom', selector: '#custom .custom-reveal' },
          { trigger: '#gallery', selector: '#gallery .gallery-item' },
          { trigger: '#why-us', selector: '#why-us .why-card' },
          { trigger: '#testimonials', selector: '#testimonials .testimonial-card' },
          { trigger: '#contact', selector: '#contact .contact-card' },
        ];

        revealGroups.forEach(({ trigger, selector }) => {
          const triggerEl = document.querySelector(trigger);
          const items = document.querySelectorAll(selector);
          if (triggerEl && items.length > 0) {
            gsap.from(items, {
              scrollTrigger: {
                trigger: triggerEl,
                start: 'top 82%',
                toggleActions: 'play none none none',
              },
              y: 36,
              opacity: 0,
              duration: 0.75,
              stagger: 0.1,
              ease: 'power3.out',
              clearProps: 'all',
            });
          }
        });

        // CTA Section Reveal
        const ctaReveals = document.querySelectorAll('.cta-reveal');
        if (ctaReveals.length > 0) {
          gsap.from(ctaReveals, {
            scrollTrigger: {
              trigger: ctaReveals[0],
              start: 'top 85%',
            },
            y: 30,
            opacity: 0,
            duration: 0.75,
            stagger: 0.12,
            ease: 'power3.out',
            clearProps: 'all',
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initInteractiveAnimations);
      } else {
        initInteractiveAnimations();
      }

      window.addEventListener('load', () => {
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
