---
const reviews = [
  {
    name: 'Siti Rahmawati',
    role: 'Pelanggan Karawang Barat',
    comment: 'Bagus banget rangkaian bunganya! Bunga mawarnya beneran fresh dan wrapping-nya rapi banget. Respon admin WA juga cepat dan ramah pas mau tanya-tanya model.',
    rating: 5,
    occasion: 'Anniversary Gift'
  },
  {
    name: 'Dimas Prasetyo',
    role: 'Pelanggan Telukjambe',
    comment: 'Pesan mendadak untuk wisuda pacar, alhamdulillah pelayanannya sangat sigap dan tepat waktu. Bunganya wangi, elegan, dan pacar saya suka banget!',
    rating: 5,
    occasion: 'Graduation Bouquet'
  },
  {
    name: 'Nadia Putri',
    role: 'Pelanggan Galuh Mas',
    comment: 'Hasil hantaran dan seserahannya cantik banget, sesuai tema pastel yang saya request. Candyzflorist bener-bener florist andalan di Karawang.',
    rating: 5,
    occasion: 'Seserahan & Lamaran'
  }
];
---

<section id="testimonials" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Trust Badge -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-floral-gold-100 text-floral-gold-800 text-xs font-semibold uppercase tracking-wider mb-4">
        ★ Trusted by Our Customers
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-floral-dark mb-4">
        Apa Kata Mereka?
      </h2>
      <p class="text-base sm:text-lg text-floral-muted">
        Kepuasan pelanggan adalah bukti dedikasi kami dalam menghadirkan rangkaian bunga terbaik di Karawang.
      </p>
    </div>

    <!-- Testimonials Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev) => (
        <div class="p-8 rounded-3xl bg-floral-cream/60 border border-floral-pink-100 shadow-soft hover:shadow-soft-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Star Ratings -->
            <div class="flex items-center gap-1 text-floral-gold-500 mb-5">
              {Array.from({ length: rev.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-sm sm:text-base text-floral-dark/90 leading-relaxed italic mb-6">
              "{rev.comment}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-floral-pink-100/70 flex items-center justify-between">
            <div>
              <h4 class="font-serif text-base font-bold text-floral-dark">{rev.name}</h4>
              <p class="text-xs text-floral-muted">{rev.role}</p>
            </div>
            <span class="text-[10px] font-semibold px-2.5 py-1 rounded-full bg-floral-pink-100 text-floral-pink-700">
              {rev.occasion}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
